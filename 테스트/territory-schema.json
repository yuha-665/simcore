          "expr": "max(0, supply - 8)"
        },
        {
          "set": "dread",
          "expr": "clamp(dread + 4, 0, 100)"
        }
      ]
    },
    {
      "id": "dig_center",
      "label": "⛏ 중앙 폐허 마을 정밀조사",
      "mode": "oneshot",
      "cooldown": 3,
      "when": "z_center == \"표면\" and supply >= 15",
      "inject": "[탐사] 중앙 폐허 마을을 파고든다. 표면 아래에 무엇이 있는지 확인한다.",
      "effects": [
        {
          "set": "z_center",
          "expr": "\"심층\""
        },
        {
          "set": "supply",
          "expr": "max(0, supply - 15)"
        },
        {
          "set": "dread",
          "expr": "clamp(dread + 8, 0, 100)"
        }
      ]
    },
    {
      "id": "trace_ruin",
      "label": "📜 폐허의 원인 추적",
      "mode": "oneshot",
      "cooldown": 4,
      "when": "deep >= 2 and not ruin_known and supply >= 12",
      "inject": "[탐사] 흩어진 단서를 모아 이 땅이 왜 버려졌는지 밝힌다.",
      "effects": [
        {
          "set": "ruin_known",
          "expr": "1"
        },
        {
          "set": "supply",
          "expr": "max(0, supply - 12)"
        }
      ]
    },
    {
      "id": "resupply",
      "label": "📦 물자 보급",
      "mode": "oneshot",
      "cooldown": 2,
      "inject": "[영지 결정] 남은 것을 긁어모아 탐사 물자를 마련한다.",
      "effects": [
        {
          "set": "supply",
          "expr": "supply + 20"
        }
      ]
    }
  ],
  "statusUI": {
    "mode": "auto",
    "groups": [
      {
        "label": "탐사",
        "items": [
          {
            "var": "day"
          },
          {
            "var": "scouts"
          },
          {
            "var": "supply"
          },
          {
            "var": "dread",
            "bar": {
              "max": 100
            }
          }
        ]
      },
      {
        "label": "영토",
        "items": [
          {
            "var": "z_north"
          },
          {
            "var": "z_west"
          },
          {
            "var": "z_south"
          },
          {
            "var": "z_east"
          },
          {
            "var": "z_center"
