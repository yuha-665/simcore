{
  "actions": [
    { "id": "work_survive", "label": "🌾 생존 우선", "mode": "oneshot",
      "when": "work != \"생존\" and not colony_lost",
      "inject": "[작업 지시] 대부분의 인력을 밭과 부엌으로 돌린다. 다른 일은 미뤄진다.",
      "effects": [{ "set": "work", "expr": "\"생존\"" }] },
    { "id": "work_stock", "label": "🪓 비축 우선", "mode": "oneshot",
      "when": "work != \"비축\" and not colony_lost",
      "inject": "[작업 지시] 벌목과 채굴에 인력을 몰아넣는다. 밥상은 얇아진다.",
      "effects": [{ "set": "work", "expr": "\"비축\"" }] },
    { "id": "work_build", "label": "🔨 건설 우선", "mode": "oneshot",
      "when": "work != \"건설\" and not colony_lost",
      "inject": "[작업 지시] 공사판에 인력을 붙인다. 망치 소리가 하루 종일 이어진다.",
      "effects": [{ "set": "work", "expr": "\"건설\"" }] },
    { "id": "work_war", "label": "⚔️ 전투 준비", "mode": "oneshot",
      "when": "work != \"전투준비\" and not colony_lost",
      "inject": "[작업 지시] 생산을 멈추고 전원 무장한다. 사격 위치와 보급을 점검한다.",
      "effects": [{ "set": "work", "expr": "\"전투준비\"" }] },
    { "id": "ration_cycle", "label": "🍲 배급 조절", "mode": "oneshot",
      "inject": "[결정] 배급량을 다시 정한다. 식당 앞 게시판이 바뀌었다.",
      "effects": [{ "set": "ration", "expr": "ration == \"중단\" ? \"절반\" : (ration == \"절반\" ? \"정상\" : (ration == \"정상\" ? \"넉넉히\" : \"중단\"))" }] },
    { "id": "hunt", "label": "🏹 사냥대 편성", "mode": "oneshot", "cooldown": 2,
      "when": "workforce >= 3 and food_left <= 15 and condition != \"독성낙진\" and not colony_lost",
      "inject": "[결정] 창고가 얇아졌다. 사냥대를 밖으로 내보낸다. 돌아올 때 뭘 짊어지고 올지는 아무도 모른다.",
      "effects": [{ "set": "food", "expr": "min(2000, food + rand(50, 95))" },
        { "set": "injured", "expr": "min(people, injured + (rand(1, 100) <= 20 ? 1 : 0))" }] },
    { "id": "forage_herbs", "label": "🌿 약초 채집", "mode": "oneshot", "cooldown": 3,
      "when": "workforce >= 2 and medicine <= 14 and condition != \"독성낙진\"",
      "inject": "[결정] 약장이 비어간다. 몇 명을 숲으로 보내 약초를 캐 오게 한다.",
      "effects": [{ "set": "medicine", "expr": "min(20, medicine + rand(5, 9))" },
        { "set": "food", "expr": "max(0, food - rand(5, 15))" }] },
    { "id": "trade_buy", "label": "🛒 보급 매입", "mode": "oneshot", "cooldown": 3,
      "when": "silver >= 180 and power == \"안정\"",
      "inject": "[교역] 통신기로 인근 파벌에 주문을 넣는다. 며칠 안에 짐이 들어온다.",
      "effects": [{ "set": "silver", "expr": "max(0, silver - 180)" },
        { "set": "food", "expr": "min(2000, food + rand(80, 140))" },
        { "set": "medicine", "expr": "min(200, medicine + rand(3, 6))" }] },
    { "id": "trade_sell", "label": "📡 잉여 매각", "mode": "oneshot", "cooldown": 4,
      "when": "food >= 300 and power == \"안정\"",
      "inject": "[교역] 남는 식량을 궤도로 올려 보낸다. 창고가 눈에 띄게 비었다.",
      "effects": [{ "set": "food", "expr": "max(0, food - 150)" },
        { "set": "silver", "expr": "min(9999, silver + rand(150, 260))" }] },
    { "id": "treat_all", "label": "🏥 집중 치료", "mode": "oneshot", "cooldown": 2,
      "when": "medicine >= 3 and (injured + sick) >= 3",
      "inject": "[의료] 약품을 아끼지 않고 환자들에게 쏟아붓는다.",
      "effects": [{ "set": "medicine", "expr": "max(0, medicine - 3)" },
        { "set": "injured", "expr": "max(0, injured - 3)" },
        { "set": "sick", "expr": "max(0, sick - 3)" },
        { "set": "mood", "expr": "min(100, mood + 3)" }] },
    { "id": "butcher", "label": "🍖 가축 도축", "mode": "oneshot", "cooldown": 2,
      "when": "animals >= 2 and food_left <= 12",
      "inject": "[결정] 식량이 모자란다. 가축 한 마리를 잡는다. 아이들에게는 보여주지 않았다.",
      "effects": [{ "set": "animals", "expr": "max(0, animals - 1)" },
        { "set": "food", "expr": "min(2000, food + rand(50, 80))" },
        { "set": "mood", "expr": "max(0, mood - (food_left <= 4 ? 0 : 2))" }] },
    { "id": "recruit", "label": "🤝 포로 회유", "mode": "oneshot", "cooldown": 4,
      "when": "prisoners >= 1 and people < 30 and mood >= 40",
      "inject": "[결정] 포로에게 합류를 제안한다. 받아들여도 시선은 한동안 따갑다.",
      "effects": [{ "set": "prisoners", "expr": "max(0, prisoners - 1)" },
        { "set": "people", "expr": "min(30, people + 1)" },
        { "set": "tension", "expr": "min(100, tension + 4)" }] },
    { "id": "harvest_organs", "label": "🩸 장기 적출", "mode": "oneshot", "cooldown": 5,
      "when": "prisoners >= 1 and mood >= 55 and tension <= 40",
      "inject": "[결정] 포로를 수술대에 올린다. 실용적인 선택이라고 누군가 말했다.",
      "effects": [{ "set": "prisoners", "expr": "max(0, prisoners - 1)" },
        { "set": "medicine", "expr": "min(200, medicine + rand(4, 8))" },
        { "set": "silver", "expr": "min(9999, silver + rand(150, 300))" },
        { "set": "mood", "expr": "max(0, mood - 8)" },
        { "set": "tension", "expr": "min(100, tension + 10)" }] },
    { "id": "feast", "label": "🎉 잔치", "mode": "oneshot", "cooldown": 8,
      "when": "food >= 200 and not colony_lost",
      "inject": "[결정] 오늘은 배급을 풀고 불을 크게 피운다. 하루쯤은 괜찮다.",
      "effects": [{ "set": "food", "expr": "max(0, food - 40)" },
        { "set": "wood", "expr": "max(0, wood - 10)" },
        { "set": "mood", "expr": "min(100, mood + 12)" },
        { "set": "tension", "expr": "max(0, tension - 18)" }] },
    { "id": "crunch_build", "label": "🏗 밤샘 공사", "mode": "oneshot", "cooldown": 3,
      "when": "wood >= 60 and components >= 6 and build < 100 and workforce >= 3",
      "inject": "[결정] 조명을 켜두고 밤새 공사를 밀어붙인다. 다들 눈이 벌겋다.",
      "effects": [{ "set": "build", "expr": "clamp(build + 40, 0, 100)" },
        { "set": "wood", "expr": "max(0, wood - 40)" },
        { "set": "components", "expr": "max(0, components - 4)" },
        { "set": "mood", "expr": "max(0, mood - 4)" }] },
    { "id": "pay_off", "label": "🕊 몸값 지불", "mode": "oneshot", "cooldown": 4,
      "when": "raid_kind != \"없음\" and raid_in > 0 and silver >= 150 and raid_margin < 0",
      "inject": "[결정] 은을 실어 보내 이번 습격을 무른다. 다음에도 통하리라는 보장은 없다.",
      "effects": [{ "set": "silver", "expr": "max(0, silver - 150)" },
        { "set": "raid_kind", "expr": "\"없음\"" },
        { "set": "raid_in", "expr": "0" },
        { "set": "tension", "expr": "min(100, tension + 3)" }] },
    { "id": "meds_daily", "label": "🧪 상시 투약", "mode": "hold",
      "when": "medicine >= 10",
      "inject": "[지속 정책] 매일 약을 돌린다. 다들 조금씩 무뎌진 얼굴이다.",
      "effects": [{ "set": "medicine", "expr": "max(0, medicine - 1)" },
        { "set": "sick", "expr": "max(0, sick - 1)" },
        { "set": "mood", "expr": "min(100, mood + 3)" },
        { "set": "tension", "expr": "max(0, tension - 4)" }] }
  ]
}
