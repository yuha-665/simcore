        },
        {
          "set": "supply",
          "expr": "max(0, supply - 8)"
        },
        {
          "set": "dread",
          "expr": "clamp(dread + 4, 0, 100)"
        }
      ]
    },
    {
      "id": "dig_east",
      "label": "⛏ 동부 붉은 강 정밀조사",
      "mode": "oneshot",
      "cooldown": 3,
      "when": "z_east == \"표면\" and supply >= 15",
      "inject": "[탐사] 동부 붉은 강을 파고든다. 표면 아래에 무엇이 있는지 확인한다.",
      "effects": [
        {
