  "derived": [
    {
      "id": "place_name",
      "label": "장소",
      "expr": "place == \"mine\" ? \"버려진 폐광\" : (place == \"marsh\" ? \"고사리 습지\" : (place == \"abbey\" ? \"무너진 수도원\" : (place == \"tomb\" ? \"왕릉 지하\" : (\"하이드아웃\"))))"
    },
    {
      "id": "danger",
      "label": "위험도",
      "expr": "place == \"mine\" ? 1 : (place == \"marsh\" ? 2 : (place == \"abbey\" ? 3 : (place == \"tomb\" ? 4 : (0))))"
    },
    {
      "id": "in_raid",
      "label": "레이드 중",
      "expr": "place != \"hideout\""
    },
    {
      "id": "carry",
      "label": "짊어진 것",
      "expr": "loot_c + loot_u + loot_r"
    },
    {
      "id": "stash",
      "label": "창고 재고",
      "expr": "stash_c + stash_u + stash_r"
    },
    {
      "id": "body",
      "label": "몸 상태",
      "expr": "hp >= 80 ? \"멀쩡하다\" : (hp >= 55 ? \"지쳤다\" : (hp >= 30 ? \"성치 않다\" : (hp >= 1 ? \"한 걸음이 위태롭다\" : (\"쓰러졌다\"))))"
    },
    {
      "id": "belly",
      "label": "허기",
      "expr": "energy >= 70 ? \"든든하다\" : (energy >= 40 ? \"출출하다\" : (energy >= 15 ? \"허기가 심하다\" : (\"굶고 있다\")))"
    },
    {
      "id": "throat",
      "label": "갈증",
      "expr": "water >= 70 ? \"괜찮다\" : (water >= 40 ? \"목이 마르다\" : (water >= 15 ? \"입안이 마른다\" : (\"탈수다\")))"
    }
  ],
  "checks": [
    {
      "id": "hire",
      "label": "고용",
      "roll": "rand(1, 48)",
      "grades": [
        {
          "when": "total >= 1 and total <= 4 and not has(roster_ally, \"Acheron\")",
          "label": "Acheron 합류 (희귀)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "Acheron"
              ]
            }
          ],
          "inject": "길드가 Acheron을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "when": "total >= 5 and total <= 8 and not has(roster_ally, \"Makima\")",
          "label": "Makima 합류 (희귀)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "Makima"
              ]
            }
          ],
          "inject": "길드가 Makima을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "when": "total >= 9 and total <= 12 and not has(roster_ally, \"Scathach\")",
          "label": "Scathach 합류 (희귀)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "Scathach"
              ]
            }
          ],
          "inject": "길드가 Scathach을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "when": "total >= 13 and total <= 16 and not has(roster_ally, \"2B\")",
          "label": "2B 합류 (희귀)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "2B"
              ]
            }
          ],
          "inject": "길드가 2B을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "when": "total >= 17 and total <= 24 and not has(roster_ally, \"Tifa_Lockhart\")",
          "label": "Tifa_Lockhart 합류 (일반)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "Tifa_Lockhart"
              ]
            }
          ],
          "inject": "길드가 Tifa_Lockhart을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "when": "total >= 25 and total <= 32 and not has(roster_ally, \"Ganyu\")",
          "label": "Ganyu 합류 (일반)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "Ganyu"
              ]
            }
          ],
          "inject": "길드가 Ganyu을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "when": "total >= 33 and total <= 40 and not has(roster_ally, \"Mirko\")",
          "label": "Mirko 합류 (일반)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "Mirko"
              ]
            }
          ],
          "inject": "길드가 Mirko을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "when": "total >= 41 and total <= 48 and not has(roster_ally, \"Nami\")",
          "label": "Nami 합류 (일반)",
          "effects": [
            {
              "list": "roster_ally",
              "add": [
                "Nami"
              ]
            }
          ],
          "inject": "길드가 Nami을(를) 데려왔다. 첫인사를 그려라 — 아직 서로를 모른다."
        },
        {
          "label": "이미 아는 얼굴",
          "effects": [
            {
              "set": "gold",
              "expr": "gold + 150"
            }
          ],
          "inject": "이미 명단에 있는 자가 불려 나왔다. 헛걸음이고, 길드가 수수료 일부를 돌려준다."
        }
      ]
    },
    {
      "id": "search",
      "label": "수색",
      "roll": "rand(1, 20)",
      "mod": "floor(hp / 40)",
      "vs": "13 - danger",
      "grades": [
        {
          "when": "total >= vs + 7",
          "label": "노다지",
          "effects": [
            {
              "set": "loot_r",
              "expr": "loot_r + 1 + floor(danger / 2)"
            },
            {
              "set": "loot_u",
              "expr": "loot_u + 1"
            }
          ],
          "inject": "이번 판의 값어치를 통째로 바꿀 물건이 나왔다."
        },
        {
          "when": "total >= vs",
          "label": "수확",
          "effects": [
            {
              "set": "loot_u",
              "expr": "loot_u + 1 + floor(danger / 2)"
            },
            {
              "set": "loot_c",
              "expr": "loot_c + 2"
            }
          ],
          "inject": "쓸 만한 것을 챙겼다."
        },
        {
          "when": "total >= vs - 4",
          "label": "푼돈",
          "effects": [
            {
              "set": "loot_c",
              "expr": "loot_c + 1"
            }
          ],
          "inject": "손에 잡힌 건 흔한 것뿐이다."
        },
        {
          "label": "헛디딤",
          "effects": [
            {
              "set": "hp",
              "expr": "max(0, hp - (12 + danger * 4))"
            }
          ],
          "inject": "뒤지다 사고가 났다. 소리가 났고, 몸도 상했다."
        }
      ]
    },
    {
      "id": "exit",
      "label": "탈출로 탐색",
      "roll": "rand(1, 20)",
      "mod": "st_scout * 2",
      "vs": "12 + danger",
      "grades": [
        {
          "when": "total >= vs",
          "label": "발견",
          "effects": [
            {
              "set": "escape_found",
              "expr": "true"
            }
          ],
          "inject": "빠져나갈 길을 찾았다. 어디로 어떻게 나가는 길인지 그려라."
        },
        {
          "when": "total >= vs - 3",
          "label": "단서",
          "inject": "길의 윤곽만 잡혔다. 확신은 없다."
        },
        {
          "label": "헛수고",
          "effects": [
            {
              "set": "hp",
              "expr": "max(0, hp - (6 + danger * 2))"
            }
          ],
          "inject": "엉뚱한 데로 돌았다. 시간과 힘만 버렸다."
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "go_mine",
      "label": "⛏️ 버려진 폐광",
      "mode": "oneshot",
      "when": "place == \"hideout\" and hp >= 25",
      "effects": [
        {
          "set": "place",
          "expr": "\"mine\""
        },
        {
          "set": "raid_turns",
          "expr": "0"
        },
        {
          "set": "escape_found",
          "expr": "false"
        }
      ],
      "inject": "하이드아웃을 떠나 버려진 폐광으로 향한다 (무너진 갱도. 얕지만 사람 손을 덜 탔다.). 가는 길과 도착했을 때의 첫인상을 그려라."
    },
    {
      "id": "go_marsh",
      "label": "🌿 고사리 습지",
      "mode": "oneshot",
      "when": "place == \"hideout\" and hp >= 25",
      "effects": [
        {
          "set": "place",
          "expr": "\"marsh\""
        },
        {
          "set": "raid_turns",
          "expr": "0"
        },
        {
          "set": "escape_found",
          "expr": "false"
        }
      ],
      "inject": "하이드아웃을 떠나 고사리 습지으로 향한다 (무릎까지 잠기는 물. 밟는 소리가 멀리 간다.). 가는 길과 도착했을 때의 첫인상을 그려라."
    },
    {
      "id": "go_abbey",
      "label": "⛪ 무너진 수도원",
      "mode": "oneshot",
      "when": "place == \"hideout\" and hp >= 25",
      "effects": [
        {
          "set": "place",
          "expr": "\"abbey\""
        },
        {
          "set": "raid_turns",
          "expr": "0"
        },
        {
          "set": "escape_found",
          "expr": "false"
        }
      ],
      "inject": "하이드아웃을 떠나 무너진 수도원으로 향한다 (성물이 남아 있다는 소문. 그만큼 붐빈다.). 가는 길과 도착했을 때의 첫인상을 그려라."
    },
    {
      "id": "go_tomb",
      "label": "⚰️ 왕릉 지하",
      "mode": "oneshot",
      "when": "place == \"hideout\" and hp >= 25",
      "effects": [
        {
          "set": "place",
          "expr": "\"tomb\""
        },
        {
          "set": "raid_turns",
          "expr": "0"
        },
        {
          "set": "escape_found",
          "expr": "false"
        }
      ],
      "inject": "하이드아웃을 떠나 왕릉 지하으로 향한다 (지도가 없다. 들어간 자가 돌아온 적이 드물다.). 가는 길과 도착했을 때의 첫인상을 그려라."
    },
    {
      "id": "search",
      "label": "🎒 뒤진다",
      "mode": "oneshot",
      "check": "search",
      "when": "place != \"hideout\"",
      "inject": "주변을 뒤져 쓸 만한 것을 찾는다."
    },
    {
      "id": "findexit",
      "label": "🚪 탈출로를 찾는다",
      "mode": "oneshot",
      "check": "exit",
      "when": "place != \"hideout\" and not escape_found",
      "inject": "빠져나갈 길을 더듬는다."
    },
    {
      "id": "extract",
      "label": "🏃 탈출한다",
      "mode": "oneshot",
      "when": "place != \"hideout\" and escape_found",
      "effects": [
        {
          "set": "stash_c",
          "expr": "stash_c + loot_c"
        },
        {
          "set": "stash_u",
          "expr": "stash_u + loot_u"
        },
        {
          "set": "stash_r",
          "expr": "stash_r + loot_r"
        },
        {
          "set": "loot_c",
          "expr": "0"
        },
        {
