          "expr": "\"심층\""
        },
        {
          "set": "supply",
          "expr": "max(0, supply - 15)"
        },
        {
          "set": "dread",
          "expr": "clamp(dread + 8, 0, 100)"
        }
      ]
    },
    {
      "id": "scout_center",
      "label": "🔍 중앙 폐허 마을 정찰",
      "mode": "oneshot",
      "cooldown": 2,
      "when": "z_center == \"미탐사\" and scouts >= 1 and supply >= 8",
      "inject": "[탐사] 척후조를 중앙 폐허 마을으로 보낸다. 무엇이 있는지는 가 봐야 안다.",
      "effects": [
