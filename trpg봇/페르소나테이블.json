      "inject": "교회의 의식으로 설아의 PC가 눈을 뜬다. 절반의 기력으로 돌아온 순간을 그려라."
    }
  ],
  "rules": {
    "onTurn": [
      {
        "set": "soyul_hp",
        "expr": "min(soyul_hp, soyul_hp_max)"
      },
      {
        "set": "hanna_hp",
        "expr": "min(hanna_hp, hanna_hp_max)"
      },
      {
        "set": "minhee_hp",
        "expr": "min(minhee_hp, minhee_hp_max)"
      },
      {
        "set": "seola_hp",
        "expr": "min(seola_hp, seola_hp_max)"
      },
      {
        "set": "soyul_mp",
        "expr": "min(soyul_mp, soyul_mp_max)"
      },
      {
        "set": "hanna_mp",
        "expr": "min(hanna_mp, hanna_mp_max)"
      },
      {
        "set": "minhee_mp",
        "expr": "min(minhee_mp, minhee_mp_max)"
      },
      {
        "set": "seola_mp",
        "expr": "min(seola_mp, seola_mp_max)"
      }
    ],
    "events": [
      {
        "id": "en_spawn",
        "when": "en_active and not en_engaged",
        "effects": [
          {
            "set": "en_hp",
            "expr": "en_hp_max"
          },
          {
            "set": "en_engaged",
            "expr": "true"
          }
        ],
        "notify": "위협이 모습을 드러냈다. 교전 상태에 들어간다 — 공격 판정으로 맞선다."
      },
      {
        "id": "en_down",
        "when": "en_engaged and en_hp <= 0",
        "effects": [
          {
            "set": "en_active",
            "expr": "false"
          },
          {
            "set": "en_engaged",
            "expr": "false"
          },
          {
            "set": "party_xp",
            "expr": "party_xp + en_band * 10 + (en_tier == '정점' ? 15 : (en_tier == '중장' ? 8 : 0))"
          },
          {
            "set": "gold",
            "expr": "gold + en_band * 12 + (en_tier == '정점' ? 25 : (en_tier == '중장' ? 10 : 0))"
          }
        ],
        "notify": "위협을 쓰러뜨렸다. 전리품과 경험이 파티에 들어온다 — 승리 직후를 그려라."
      },
      {
        "id": "ko_soyul",
        "when": "soyul_hp <= 0 and soyul_cond != '전투불능'",
        "effects": [
          {
            "set": "soyul_cond",
            "expr": "'전투불능'"
          }
        ],
        "notify": "소율의 PC가 쓰러졌다. 교회의 의식 없이는 일어나지 못한다."
      },
      {
        "id": "ko_hanna",
        "when": "hanna_hp <= 0 and hanna_cond != '전투불능'",
        "effects": [
          {
            "set": "hanna_cond",
            "expr": "'전투불능'"
          }
        ],
        "notify": "한나의 PC가 쓰러졌다. 교회의 의식 없이는 일어나지 못한다."
      },
      {
        "id": "ko_minhee",
        "when": "minhee_hp <= 0 and minhee_cond != '전투불능'",
        "effects": [
          {
            "set": "minhee_cond",
            "expr": "'전투불능'"
          }
        ],
        "notify": "민희의 PC가 쓰러졌다. 교회의 의식 없이는 일어나지 못한다."
      },
      {
        "id": "ko_seola",
        "when": "seola_hp <= 0 and seola_cond != '전투불능'",
        "effects": [
          {
            "set": "seola_cond",
            "expr": "'전투불능'"
          }
        ],
        "notify": "설아의 PC가 쓰러졌다. 교회의 의식 없이는 일어나지 못한다."
      },
      {
        "id": "lv_soyul",
        "when": "party_xp >= soyul_xp_need and soyul_level < 8",
        "effects": [
          {
            "set": "soyul_level",
            "expr": "soyul_level + 1"
          },
          {
            "set": "soyul_ap",
            "expr": "soyul_ap + 1"
          }
        ],
        "notify": "소율의 PC가 레벨업했다 (AP +1). 시트 패널에서 능력치에 투자할 수 있다."
      },
      {
        "id": "lv_hanna",
        "when": "party_xp >= hanna_xp_need and hanna_level < 8",
        "effects": [
          {
            "set": "hanna_level",
            "expr": "hanna_level + 1"
          },
          {
            "set": "hanna_ap",
            "expr": "hanna_ap + 1"
          }
        ],
        "notify": "한나의 PC가 레벨업했다 (AP +1). 시트 패널에서 능력치에 투자할 수 있다."
      },
      {
        "id": "lv_minhee",
        "when": "party_xp >= minhee_xp_need and minhee_level < 8",
        "effects": [
          {
            "set": "minhee_level",
            "expr": "minhee_level + 1"
          },
          {
            "set": "minhee_ap",
            "expr": "minhee_ap + 1"
          }
        ],
        "notify": "민희의 PC가 레벨업했다 (AP +1). 시트 패널에서 능력치에 투자할 수 있다."
      },
      {
        "id": "lv_seola",
        "when": "party_xp >= seola_xp_need and seola_level < 8",
        "effects": [
          {
            "set": "seola_level",
            "expr": "seola_level + 1"
          },
          {
            "set": "seola_ap",
            "expr": "seola_ap + 1"
          }
        ],
        "notify": "설아의 PC가 레벨업했다 (AP +1). 시트 패널에서 능력치에 투자할 수 있다."
      }
    ]
  },
  "directives": [
    {
      "id": "daily",
      "when": "scene == '일상'",
      "text": "지금은 동아리방 일상이다. 세션 준비·잡담·관계가 중심이고, TRPG 수치는 잠들어 있다. 세션 시작을 재촉하지 마라."
    },
    {
      "id": "campaign",
      "when": "scene == '세션'",
      "text": "장편 캠페인 진행 중이다. 시나리오의 종결·클리어·마무리를 먼저 제안하거나 서두르지 마라 — 끝내는 선언은 오직 GM(유저)의 몫이다. 막히면 단서·압박·반응으로 장면을 잇는다."
    },
    {
      "id": "engage",
      "when": "en_engaged",
      "text": "교전 중이다 — 적 HP {en_hp}/{en_hp_max}, 위협 단계 {en_band}({en_tier}). 피해와 처치는 [판정] 결과가 정한다. 수치를 본문에 적지 말고 타격의 무게로 묘사하라."
    },
    {
      "id": "downed",
      "when": "downs >= 1",
      "text": "전투불능인 PC가 {downs}명 있다. 그들은 행동 선언을 할 수 없고, 교회 의식 전에는 일어나지 못한다."
    },
    {
      "id": "ask_roll",
      "when": "scene == '세션' and not need_roll",
      "text": "[판정 안내] 성패가 갈릴 행동인데 [판정] 결과가 함께 없다면 결과를 임의로 정하지 말고, 판정이 필요하다는 것만 드러내라. 수치는 시스템이 굴린다."
    }
  ],
