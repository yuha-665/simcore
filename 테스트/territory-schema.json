        },
        {
          "set": "supply",
          "expr": "max(0, supply - 8)"
        },
        {
          "set": "dread",
          "expr": "clamp(dread + 4, 0, 100)"
        }
      ]
    },
    {
      "id": "dig_south",
      "label": "⛏ 남부 잿빛 평야 정밀조사",
      "mode": "oneshot",
      "cooldown": 3,
      "when": "z_south == \"표면\" and supply >= 15",
      "inject": "[탐사] 남부 잿빛 평야을 파고든다. 표면 아래에 무엇이 있는지 확인한다.",
      "effects": [
