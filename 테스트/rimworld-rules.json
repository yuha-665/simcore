{
  "rules": {
    "onTurn": [
      { "set": "food", "expr": "max(0, food - food_need)" },
      { "set": "wood", "expr": "max(0, wood - (temp < 0 ? 12 : (temp < 12 ? 6 : 3)))" },
      { "set": "injured", "expr": "max(0, injured - (medicine >= 2 ? 2 : 1))" },
      { "set": "sick", "expr": "clamp(sick + (medicine >= 2 ? -1 : 1) + ((temp < -20 or temp > 45) ? 1 : 0) + (condition == \"독성낙진\" ? 2 : 0) + (food <= 0 ? 1 : 0), 0, max(0, people - injured))" },
      { "set": "medicine", "expr": "max(0, medicine - ((injured + sick) > 0 ? 2 : 0))" },
      { "set": "mood", "expr": "clamp(mood + (food > 0 ? 1 : -6) + ((temp < -20 or temp > 45) ? -4 : ((temp < 0 or temp > 32) ? -2 : 0)) + (ration == \"넉넉히\" ? 2 : (ration == \"정상\" ? 0 : (ration == \"절반\" ? -3 : -8))) + (condition != \"없음\" ? -2 : 0) + (tension >= 60 ? -3 : 0) + (power == \"정지\" ? -2 : 0), 0, 100)" },
      { "set": "tension", "expr": "clamp(tension + (mood < 35 ? 5 : (mood > 70 ? -3 : 0)) + (people > 12 ? 2 : 0) + (prisoners > 0 ? 1 : 0) + (storyteller == \"드라마\" ? 2 : 0), 0, 100)" },
      { "set": "condition_left", "expr": "max(0, condition_left - 1)" },
      { "set": "raid_in", "expr": "max(0, raid_in - 1)" },
      { "set": "temp", "expr": "clamp(round(temp + (temp_target - temp) * 0.4), -60, 60)" },
      { "set": "wealth", "expr": "max(0, round(silver * 0.5 + food * 0.6 + wood * 0.4 + components * 12 + medicine * 8 + defense * 120 + people * 60 + animals * 25 + ship_parts * 300))" },
      { "set": "day", "expr": "day + 1" }
    ],
    "events": [
      { "id": "cap_casualty", "when": "sick + injured > people",
        "effects": [{ "set": "sick", "expr": "max(0, people - injured)" }] },
      { "id": "condition_end", "when": "condition != \"없음\" and condition_left <= 0",
        "effects": [{ "set": "condition", "expr": "\"없음\"" }],
        "notify": "하늘이 원래대로 돌아왔다. 이상 기후가 물러갔다." },
      { "id": "flare_blackout", "when": "condition == \"태양플레어\" and power != \"정지\"",
        "effects": [{ "set": "power", "expr": "\"정지\"" }],
        "notify": "태양 플레어가 전자기기를 전부 태웠다. 기지 전체가 어둠에 잠긴다." },
      { "id": "eclipse_brownout", "when": "condition == \"일식\" and power == \"안정\"",
        "effects": [{ "set": "power", "expr": "\"부족\"" }],
        "notify": "태양이 가려졌다. 태양광 패널이 죽은 판이 되었다." },
      { "id": "power_restored", "when": "power != \"안정\" and condition != \"태양플레어\" and condition != \"일식\" and components >= 2",
        "effects": [{ "set": "power", "expr": "\"안정\"" }, { "set": "components", "expr": "max(0, components - 2)" }],
        "notify": "부품을 갈아 끼우고 전력망을 되살렸다." },
      { "id": "freezing_no_fuel", "when": "wood <= 0 and temp < -5",
        "effects": [{ "set": "sick", "expr": "clamp(sick + 1, 0, people)" }, { "set": "mood", "expr": "max(0, mood - 4)" }],
        "notify": "땔감이 없다. 난로가 꺼진 방에서 다들 옷을 껴입고 잔다." },
      { "id": "starving", "when": "food <= 0",
        "effects": [{ "set": "mood", "expr": "max(0, mood - 6)" }, { "set": "tension", "expr": "min(100, tension + 7)" }],
        "notify": "식량 창고가 비었다. 저녁 시간에 아무도 식당에 오지 않는다." },
      { "id": "famine_death", "when": "food <= 0 and mood <= 20 and people > 0",
        "effects": [{ "set": "people", "expr": "max(0, people - 1)" }, { "set": "mood", "expr": "max(0, mood - 10)" }],
        "notify": "굶주림으로 한 명이 침대에서 일어나지 못했다." },
      { "id": "raid_lands", "when": "raid_kind != \"없음\" and raid_in <= 0",
        "effects": [
          { "set": "injured", "expr": "min(people, injured + max(1, round(abs(raid_margin) / 10)))" },
          { "set": "people", "expr": "max(0, people - (raid_margin < 0 ? max(1, round(abs(raid_margin) / 12)) : 0))" },
          { "set": "silver", "expr": "raid_margin >= 0 ? silver + rand(40, 160) : max(0, silver - round(silver * 0.4))" },
          { "set": "food", "expr": "raid_margin >= 0 ? food : max(0, food - round(food * 0.3))" },
          { "set": "medicine", "expr": "max(0, medicine - 3)" },
          { "set": "defense", "expr": "clamp(defense - (raid_margin < -20 ? 1 : 0), 1, 5)" },
          { "set": "prisoners", "expr": "prisoners + (raid_margin >= 15 ? 1 : 0)" },
          { "set": "mood", "expr": "clamp(mood + (raid_margin >= 0 ? 6 : -12), 0, 100)" },
          { "set": "tension", "expr": "clamp(tension + (raid_margin >= 0 ? -3 : 8), 0, 100)" },
          { "set": "raid_kind", "expr": "\"없음\"" },
          { "set": "raid_in", "expr": "0" }],
        "notify": "적대 세력이 경계선을 넘었다. 전투가 벌어진다." },
      { "id": "plague_outbreak", "when": "people > 0 and sick >= round(people * 0.5)",
        "effects": [
          { "set": "people", "expr": "max(0, people - 1)" },
          { "set": "sick", "expr": "round(sick * 0.5)" },
          { "set": "mood", "expr": "max(0, mood - 8)" },
          { "set": "tension", "expr": "min(100, tension + 6)" }],
        "notify": "병상이 모자란다. 결국 한 명을 잃었다." },
      { "id": "mental_break", "when": "mood <= 25 and not colony_lost",
        "effects": [
          { "set": "mood", "expr": "32" },
          { "set": "tension", "expr": "min(100, tension + 12)" },
          { "set": "wood", "expr": "max(0, wood - rand(20, 60))" },
          { "set": "food", "expr": "max(0, food - rand(10, 40))" }],
        "notify": "누군가 무너졌다. 물건을 부수고 창고를 헤집었다." },
      { "id": "social_fight", "when": "tension >= 70 and people >= 2 and not colony_lost",
        "effects": [
          { "set": "injured", "expr": "min(people, injured + 1)" },
          { "set": "tension", "expr": "max(0, tension - 22)" },
          { "set": "mood", "expr": "max(0, mood - 4)" }],
        "notify": "말다툼이 주먹다짐으로 번졌다. 한 명이 코를 붙잡고 물러났다." },
      { "id": "prisoner_break", "when": "prisoners > 0 and workforce < prisoners",
        "effects": [
          { "set": "prisoners", "expr": "0" },
          { "set": "injured", "expr": "min(people, injured + 1)" },
          { "set": "silver", "expr": "max(0, silver - rand(50, 150))" }],
        "notify": "감시할 사람이 없었다. 포로들이 문을 부수고 달아났다." },
      { "id": "colony_break", "when": "tension >= 92 and not colony_lost",
        "effects": [{ "set": "colony_lost", "expr": "1" }],
        "notify": "더는 같은 편이 아니다. 정착지가 두 쪽으로 갈라졌다." },
      { "id": "wipeout", "when": "people <= 0 and not colony_lost",
        "effects": [{ "set": "colony_lost", "expr": "1" }],
        "notify": "마지막 한 명이 쓰러졌다. 이제 이곳에는 아무도 없다." },
      { "id": "first_year", "once": true, "when": "day >= 60 and not colony_lost",
        "effects": [{ "set": "mood", "expr": "min(100, mood + 10)" }],
        "notify": "첫 해가 지났다. 아직 살아 있다는 사실 자체가 성취다." },
      { "id": "escape", "once": true, "when": "ship_parts >= 6 and not colony_lost",
        "effects": [{ "set": "mood", "expr": "100" }],
        "notify": "우주선이 완성됐다. 이 행성을 떠날 수 있다." }
    ],
    "randomEvents": {
      "chancePerTurn": 0.55,
      "table": [
        { "id": "eclipse", "weight": 3, "cooldown": 8, "when": "condition == \"없음\"",
          "effects": [{ "set": "condition", "expr": "\"일식\"" }, { "set": "condition_left", "expr": "rand(3, 6)" }],
          "notify": "대낮에 해가 사라졌다. 작물이 자라기를 멈춘다." },
        { "id": "solar_flare", "weight": 2, "cooldown": 10, "when": "condition == \"없음\"",
          "effects": [{ "set": "condition", "expr": "\"태양플레어\"" }, { "set": "condition_left", "expr": "rand(2, 5)" }, { "set": "components", "expr": "max(0, components - rand(2, 6))" }],
          "notify": "하늘이 하얗게 번쩍였다. 회로 타는 냄새가 기지를 채운다." },
        { "id": "toxic_fallout", "weight": 2, "cooldown": 14, "when": "condition == \"없음\"",
          "effects": [{ "set": "condition", "expr": "\"독성낙진\"" }, { "set": "condition_left", "expr": "rand(5, 12)" }, { "set": "animals", "expr": "max(0, animals - rand(1, 3))" }],
          "notify": "잿빛 먼지가 눈처럼 내린다. 밖에 있던 것들이 먼저 죽어간다." },
        { "id": "volcanic_winter", "weight": 1, "cooldown": 20, "when": "condition == \"없음\"",
          "effects": [{ "set": "condition", "expr": "\"화산겨울\"" }, { "set": "condition_left", "expr": "rand(10, 20)" }, { "set": "temp", "expr": "clamp(temp - rand(8, 14), -60, 60)" }],
          "notify": "지평선 너머에서 화산재 기둥이 올라왔다. 햇빛이 흐려진다." },
        { "id": "cold_snap", "weight": 3, "cooldown": 6, "when": "condition == \"없음\" and temp < 20",
          "effects": [{ "set": "condition", "expr": "\"한파\"" }, { "set": "condition_left", "expr": "rand(3, 7)" }, { "set": "temp", "expr": "clamp(temp - rand(12, 22), -60, 60)" }],
          "notify": "기온이 하룻밤 사이에 곤두박질쳤다. 수도관이 얼어붙는다." },
        { "id": "heat_wave", "weight": 3, "cooldown": 6, "when": "condition == \"없음\" and temp > 5",
          "effects": [{ "set": "condition", "expr": "\"혹서\"" }, { "set": "condition_left", "expr": "rand(3, 7)" }, { "set": "temp", "expr": "clamp(temp + rand(12, 22), -60, 60)" }],
          "notify": "공기가 끓는다. 그늘에서도 땀이 멈추지 않는다." },
        { "id": "flashstorm", "weight": 2, "cooldown": 7, "when": "condition == \"없음\" and temp > 0",
          "effects": [{ "set": "condition", "expr": "\"뇌우\"" }, { "set": "condition_left", "expr": "rand(2, 4)" }, { "set": "wood", "expr": "max(0, wood - rand(30, 80))" }],
          "notify": "번개가 쉬지 않고 내리꽂힌다. 나무가 하나씩 불붙는다." },
        { "id": "wildfire", "weight": 2, "cooldown": 8, "when": "temp > 15",
          "effects": [{ "set": "wood", "expr": "max(0, wood - rand(60, 140))" }, { "set": "food", "expr": "max(0, food - rand(20, 60))" }, { "set": "injured", "expr": "min(people, injured + 1)" }],
          "notify": "산불이 방화선을 넘었다. 연기 때문에 앞이 보이지 않는다." },
        { "id": "blight", "weight": 3, "cooldown": 8, "when": "food > 40",
          "effects": [{ "set": "food", "expr": "max(0, food - round(food * 0.3))" }],
          "notify": "작물 잎이 검게 말라간다. 밭 한쪽을 통째로 갈아엎어야 한다." },
        { "id": "disease_outbreak", "weight": 3, "cooldown": 6, "when": "people > 1",
          "effects": [{ "set": "sick", "expr": "clamp(sick + rand(1, 3), 0, max(0, people - injured))" }, { "set": "mood", "expr": "max(0, mood - 3)" }],
          "notify": "열이 오르고 기침이 시작됐다. 한 명이 아니다." },
        { "id": "raid_tribal", "weight": 4, "cooldown": 4, "when": "raid_kind == \"없음\" and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"부족민\"" }, { "set": "raid_in", "expr": "rand(1, 2)" }],
          "notify": "숲 가장자리에서 활을 든 무리가 이쪽을 살피고 있다." },
        { "id": "raid_pirate", "weight": 4, "cooldown": 4, "when": "raid_kind == \"없음\" and wealth >= 2000 and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"해적\"" }, { "set": "raid_in", "expr": "rand(1, 3)" }],
          "notify": "해적단이 이 정착지의 좌표를 확보했다는 신호가 잡혔다." },
        { "id": "raid_siege", "weight": 2, "cooldown": 8, "when": "raid_kind == \"없음\" and wealth >= 3500 and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"공성\"" }, { "set": "raid_in", "expr": "rand(2, 4)" }],
          "notify": "사거리 밖에 진지가 세워지고 있다. 박격포를 조립하는 소리가 들린다." },
        { "id": "raid_droppod", "weight": 3, "cooldown": 6, "when": "raid_kind == \"없음\" and wealth >= 2500 and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"드롭포드\"" }, { "set": "raid_in", "expr": "1" }, { "set": "defense", "expr": "clamp(defense - 1, 1, 5)" }],
          "notify": "강하 포드가 방벽 안쪽에 직접 떨어졌다. 문이 열리는 소리." },
        { "id": "raid_sappers", "weight": 2, "cooldown": 7, "when": "raid_kind == \"없음\" and defense >= 3 and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"해적\"" }, { "set": "raid_in", "expr": "rand(1, 2)" }, { "set": "defense", "expr": "clamp(defense - 1, 1, 5)" }],
          "notify": "정문을 무시하고 뒷벽을 파고 들어오는 소리가 난다." },
        { "id": "raid_mech", "weight": 2, "cooldown": 10, "when": "raid_kind == \"없음\" and wealth >= 4500 and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"메카노이드\"" }, { "set": "raid_in", "expr": "rand(1, 2)" }],
          "notify": "금속 다리가 땅을 두드리는 규칙적인 소리가 다가온다." },
        { "id": "mech_cluster", "weight": 1, "cooldown": 16, "when": "raid_kind == \"없음\" and wealth >= 7000 and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"메카노이드\"" }, { "set": "raid_in", "expr": "rand(3, 6)" }, { "set": "mood", "expr": "max(0, mood - 5)" }],
          "notify": "기계 구조물이 통째로 강하해 정착지 옆에 박혔다. 아직은 조용하다." },
        { "id": "infestation", "weight": 2, "cooldown": 9, "when": "raid_kind == \"없음\" and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"벌레\"" }, { "set": "raid_in", "expr": "1" }, { "set": "food", "expr": "max(0, food - rand(20, 50))" }],
          "notify": "바닥이 갈라지고 젤리 같은 덩어리가 솟아올랐다. 안에서 뭔가 움직인다." },
        { "id": "manhunter_pack", "weight": 3, "cooldown": 6, "when": "raid_kind == \"없음\" and not colony_lost",
          "effects": [{ "set": "raid_kind", "expr": "\"광란야수\"" }, { "set": "raid_in", "expr": "1" }],
          "notify": "짐승 떼가 사람만 보고 달려온다. 도망치지 않는다." },
        { "id": "extortion", "weight": 2, "cooldown": 10, "when": "silver >= 200 and not colony_lost",
          "effects": [{ "set": "silver", "expr": "max(0, silver - round(silver * 0.35))" }, { "set": "mood", "expr": "max(0, mood - 3)" }, { "set": "tension", "expr": "min(100, tension + 4)" }],
          "notify": "무전이 들어왔다. 은을 보내면 이번엔 지나가겠다고 한다." },
        { "id": "trader_bulk", "weight": 4, "cooldown": 4, "when": "silver >= 100",
          "effects": [{ "set": "food", "expr": "food + rand(80, 200)" }, { "set": "wood", "expr": "wood + rand(40, 120)" }, { "set": "silver", "expr": "max(0, silver - rand(80, 200))" }],
          "notify": "짐수레를 끌고 온 벌크 상인이 마당에 자리를 폈다." },
        { "id": "trader_combat", "weight": 3, "cooldown": 5, "when": "silver >= 150",
          "effects": [{ "set": "medicine", "expr": "medicine + rand(4, 10)" }, { "set": "components", "expr": "components + rand(3, 8)" }, { "set": "silver", "expr": "max(0, silver - rand(120, 280))" }],
          "notify": "무장한 상단이 들렀다. 파는 물건이 하나같이 비싸고 하나같이 필요하다." },
        { "id": "orbital_trader", "weight": 3, "cooldown": 5, "when": "power == \"안정\"",
          "effects": [{ "set": "silver", "expr": "silver + rand(150, 400)" }, { "set": "food", "expr": "max(0, food - rand(40, 100))" }],
          "notify": "궤도 무역선이 통신을 걸어왔다. 남는 것을 팔 기회다." },
        { "id": "slave_trader", "weight": 2, "cooldown": 6, "when": "prisoners > 0",
          "effects": [{ "set": "prisoners", "expr": "max(0, prisoners - 1)" }, { "set": "silver", "expr": "silver + rand(150, 350)" }, { "set": "mood", "expr": "max(0, mood - 6)" }, { "set": "tension", "expr": "min(100, tension + 5)" }],
          "notify": "노예상이 포로 한 명을 데려갔다. 아무도 그 이야기를 꺼내지 않는다." },
        { "id": "visitors", "weight": 3, "cooldown": 4,
          "effects": [{ "set": "mood", "expr": "min(100, mood + 5)" }, { "set": "food", "expr": "max(0, food - rand(15, 40))" }],
          "notify": "이웃 파벌의 방문단이 며칠 묵어가겠다며 들어왔다." },
        { "id": "wanderer_joins", "weight": 3, "cooldown": 6, "when": "people < 16",
          "effects": [{ "set": "people", "expr": "people + 1" }, { "set": "mood", "expr": "min(100, mood + 4)" }],
          "notify": "혼자 걸어온 사람이 있다. 어디서 왔는지는 말하지 않았다." },
        { "id": "refugee_chased", "weight": 2, "cooldown": 8, "when": "people < 16 and raid_kind == \"없음\"",
          "effects": [{ "set": "people", "expr": "people + 1" }, { "set": "injured", "expr": "min(people + 1, injured + 1)" }, { "set": "raid_kind", "expr": "\"해적\"" }, { "set": "raid_in", "expr": "rand(2, 3)" }],
          "notify": "피투성이가 된 사람이 문을 두드렸다. 뒤에 쫓아오는 것들이 있다." },
        { "id": "wanderer_sick", "weight": 2, "cooldown": 7, "when": "people < 16",
          "effects": [{ "set": "people", "expr": "people + 1" }, { "set": "sick", "expr": "clamp(sick + 1, 0, people + 1)" }],
          "notify": "쓰러진 표류자를 안으로 들였다. 열이 심하다." },
        { "id": "self_tame", "weight": 2, "cooldown": 5,
          "effects": [{ "set": "animals", "expr": "animals + 1" }, { "set": "mood", "expr": "min(100, mood + 3)" }],
          "notify": "야생 동물 한 마리가 제 발로 따라 들어와 나가지 않는다." },
        { "id": "empire_envoy", "weight": 2, "cooldown": 9, "when": "wealth >= 3000",
          "effects": [{ "set": "silver", "expr": "silver + rand(100, 300)" }, { "set": "food", "expr": "max(0, food - rand(30, 70))" }, { "set": "tension", "expr": "min(100, tension + 5)" }],
          "notify": "제국 사절이 도착했다. 예우를 요구하고, 대가는 넉넉히 치른다." },
        { "id": "cargo_pods", "weight": 3, "cooldown": 5,
          "effects": [{ "set": "silver", "expr": "silver + rand(30, 120)" }, { "set": "food", "expr": "food + rand(20, 80)" }, { "set": "components", "expr": "components + rand(1, 5)" }],
          "notify": "화물 포드 몇 개가 근처 들판에 떨어졌다. 주인은 없다." },
        { "id": "meteorite", "weight": 2, "cooldown": 6,
          "effects": [{ "set": "components", "expr": "components + rand(4, 12)" }],
          "notify": "운석이 떨어져 땅을 파놨다. 쓸 만한 광물이 박혀 있다." },
        { "id": "ancient_shrine", "weight": 2, "cooldown": 12, "when": "workforce >= 3",
          "effects": [{ "set": "components", "expr": "components + rand(6, 15)" }, { "set": "silver", "expr": "silver + rand(100, 250)" }, { "set": "injured", "expr": "min(people, injured + rand(1, 2))" }],
          "notify": "봉인된 고대 구조물을 열었다. 안에 있던 것도 같이 깨어났다." },
        { "id": "ship_part_crash", "weight": 1, "cooldown": 14, "when": "ship_parts < 6 and raid_kind == \"없음\"",
          "effects": [{ "set": "ship_parts", "expr": "min(6, ship_parts + 1)" }, { "set": "raid_kind", "expr": "\"메카노이드\"" }, { "set": "raid_in", "expr": "rand(2, 4)" }, { "set": "mood", "expr": "min(100, mood + 6)" }],
          "notify": "우주선 부품이 추락했다. 회수했지만, 신호를 따라오는 것들이 있다." },
        { "id": "earthquake", "weight": 2, "cooldown": 10,
          "effects": [{ "set": "defense", "expr": "clamp(defense - 1, 1, 5)" }, { "set": "wood", "expr": "max(0, wood - rand(20, 60))" }, { "set": "injured", "expr": "min(people, injured + 1)" }],
          "notify": "땅이 흔들리고 지붕 한쪽이 내려앉았다." },
        { "id": "party", "weight": 3, "cooldown": 6, "when": "food > 60",
          "effects": [{ "set": "mood", "expr": "min(100, mood + 12)" }, { "set": "tension", "expr": "max(0, tension - 10)" }, { "set": "food", "expr": "max(0, food - rand(20, 50))" }],
          "notify": "누가 술을 꺼냈다. 오늘 밤만은 아무도 일하지 않는다." },
        { "id": "marriage", "weight": 2, "cooldown": 12, "when": "people >= 4 and mood >= 45",
          "effects": [{ "set": "mood", "expr": "min(100, mood + 15)" }, { "set": "tension", "expr": "max(0, tension - 8)" }, { "set": "food", "expr": "max(0, food - rand(30, 60))" }, { "set": "silver", "expr": "max(0, silver - rand(50, 120))" }],
          "notify": "결혼식이 열렸다. 이 행성에서 가장 어울리지 않는 종류의 행사다." },
        { "id": "birth", "weight": 1, "cooldown": 20, "when": "people >= 4 and mood >= 55 and food > 100",
          "effects": [{ "set": "people", "expr": "people + 1" }, { "set": "mood", "expr": "min(100, mood + 10)" }, { "set": "food", "expr": "max(0, food - 30)" }],
          "notify": "아이가 태어났다. 울음소리가 기지 벽에 부딪혀 울린다." },
        { "id": "drug_binge", "weight": 2, "cooldown": 7, "when": "medicine >= 3",
          "effects": [{ "set": "mood", "expr": "min(100, mood + 8)" }, { "set": "medicine", "expr": "max(0, medicine - rand(2, 5))" }, { "set": "tension", "expr": "min(100, tension + 8)" }],
          "notify": "약품 창고가 털렸다. 누가 그랬는지는 다들 알고 있다." },
        { "id": "arson", "weight": 2, "cooldown": 9, "when": "mood < 55",
          "effects": [{ "set": "wood", "expr": "max(0, wood - rand(40, 100))" }, { "set": "defense", "expr": "clamp(defense - 1, 1, 5)" }, { "set": "mood", "expr": "max(0, mood - 6)" }, { "set": "tension", "expr": "min(100, tension + 10)" }],
          "notify": "창고에 불이 붙었다. 불씨는 안쪽에서 시작됐다." },
        { "id": "inspiration", "weight": 2, "cooldown": 8, "when": "mood >= 50 and workforce >= 2",
          "effects": [{ "set": "components", "expr": "components + rand(3, 8)" }, { "set": "defense", "expr": "clamp(defense + 1, 1, 5)" }, { "set": "mood", "expr": "min(100, mood + 5)" }],
          "notify": "한 명이 사흘 밤을 새워 뭔가를 만들어냈다. 본인도 왜 되는지는 모른다." },
        { "id": "catatonia", "weight": 2, "cooldown": 7, "when": "mood < 45 and workforce >= 2",
          "effects": [{ "set": "sick", "expr": "clamp(sick + 1, 0, max(0, people - injured))" }, { "set": "mood", "expr": "max(0, mood - 4)" }],
          "notify": "한 명이 침대에서 천장만 본다. 불러도 대답하지 않는다." },
        { "id": "randy_gift", "weight": 2, "cooldown": 6, "when": "storyteller == \"랜디\"",
          "effects": [{ "set": "silver", "expr": "silver + rand(200, 600)" }, { "set": "medicine", "expr": "medicine + rand(3, 10)" }],
          "notify": "이유 없이 금괴가 든 포드가 떨어졌다. 우주가 오늘은 기분이 좋은 모양이다." },
        { "id": "drama_rift", "weight": 3, "cooldown": 5, "when": "storyteller == \"드라마\" and people >= 3",
          "effects": [{ "set": "tension", "expr": "min(100, tension + 14)" }, { "set": "mood", "expr": "max(0, mood - 5)" }],
          "notify": "출신도 시대도 다른 두 사람이 도저히 넘을 수 없는 선을 확인했다." }
      ]
    }
  },
  "directives": [
    { "id": "raid_warning", "when": "raid_kind != \"없음\" and raid_in > 0",
      "text": "[상태] {raid_in}일 뒤 {raid_kind} 세력이 도착한다. 방어 준비, 초조함, 무기 손질 — 다가오는 위협이 장면 전체에 그림자를 드리워야 한다." },
    { "id": "raid_outmatched", "when": "raid_kind != \"없음\" and raid_margin < 0",
      "text": "[상태] 방어력({def_power})이 적 전력({raid_power})에 미치지 못한다. 이길 수 있다는 낙관을 서술하지 마라. 누가 남고 누가 도망칠지 이야기가 오가야 한다." },
    { "id": "deadly_cold", "when": "temp < -20",
      "text": "[상태] 기온 {temp}°C. 입김, 동상, 얼어붙은 문고리 — 추위가 장면의 전면에 나와야 한다." },
    { "id": "deadly_heat", "when": "temp > 45",
      "text": "[상태] 기온 {temp}°C. 열사병, 마르는 목, 그늘 다툼 — 더위가 모든 행동을 느리게 만든다." },
    { "id": "blackout", "when": "power == \"정지\"",
      "text": "[상태] 전력이 끊겼다. 조명, 냉동고, 자동 포탑 — 전기로 돌아가던 것들이 전부 죽었다는 전제로 서술하라." },
    { "id": "sky_condition", "when": "condition != \"없음\"",
      "text": "[상태] 현재 지역 이상: {condition} (잔여 {condition_left}일). 하늘과 공기의 묘사를 매 장면 도입부에 넣어라." },
    { "id": "hungry", "when": "food <= 0",
      "text": "[상태] 식량이 없다. 굶주림과 그로 인한 다툼, 먹을 것을 둘러싼 시선이 드러나야 한다." },
    { "id": "sickbay", "when": "sick + injured >= round(people * 0.4) and people > 0",
      "text": "[상태] 정착민 {people}명 중 {sick}명이 아프고 {injured}명이 다쳤다. 일손이 모자라고 신음 소리가 배경에 깔린다." },
    { "id": "low_mood", "when": "mood <= 35 and not colony_lost",
      "text": "[상태] 사기 {mood}. 말수가 줄고, 사소한 일에 폭발하기 직전인 사람이 최소 한 명은 있어야 한다." },
    { "id": "unrest", "when": "tension >= 65 and not colony_lost",
      "text": "[상태] 갈등 {tension}. 파벌이 갈렸고, 식탁에서 서로 다른 쪽에 앉는다." },
    { "id": "broken", "when": "colony_lost",
      "text": "[상태] 정착지가 붕괴했다. 명령이 먹히지 않는다는 사실을 전제로 서술하라. 각자 살길을 찾는 장면만 나온다." },
    { "id": "rich_target", "when": "wealth >= 6000 and not colony_lost",
      "text": "[상태] 부 {wealth}. 이 정착지는 이미 눈에 띄는 표적이다. 풍요와 불안이 같은 장면에 공존해야 한다." },
    { "id": "randy_tone", "when": "storyteller == \"랜디\"",
      "text": "[연출] 인과를 맞추려 하지 마라. 축복과 재앙이 아무 예고 없이, 아무 순서 없이 온다." },
    { "id": "cassandra_tone", "when": "storyteller == \"카산드라\"",
      "text": "[연출] 정착지가 성장한 만큼 세계가 정확히 그만큼 되받아친다. 압박이 계단식으로 올라가고 있음을 암시하라." },
    { "id": "drama_tone", "when": "storyteller == \"드라마\"",
      "text": "[연출] 외부 위협보다 내부 관계를 앞세워라. 출신 세계가 다른 인물들의 가치관 충돌, 오해, 애정과 원한을 장면의 중심에 둔다." }
  ]
}
